# Gemini API Key for LowCost tier. If empty, Gemini LowCost tier will be disabled.
AL_LLM__GEMINI__LOWCOST__API_KEY=""
AL_LLM__GEMINI__LOWCOST__MODELS="gemini-3.5-flash-lite, gemini-3.6-flash"

# Gemini API Key for Premium tier. If empty, Gemini Premium tier will be disabled.
AL_LLM__GEMINI__PREMIUM__API_KEY=""
AL_LLM__GEMINI__PREMIUM__MODELS="gemini-2.5-pro, gemini-3.1-pro-preview"

# ----------------------------------------------------------------------#

# OpenAI API Key and Endpoint for LowCost tier. If empty, OpenAI LowCost tier will be disabled.
AL_LLM__OPENAI__LOWCOST__API_KEY=""
AL_LLM__OPENAI__LOWCOST__ENDPOINT=""
AL_LLM__OPENAI__LOWCOST__MODELS="gpt-5.6-luna, gpt-5.4-mini"

# OpenAI API Key and Endpoint for Premium tier. If empty, OpenAI Premium tier will be disabled.
AL_LLM__OPENAI__PREMIUM__API_KEY=""
AL_LLM__OPENAI__PREMIUM__ENDPOINT=""
AL_LLM__OPENAI__PREMIUM__MODELS="gpt-5.6-terra, gpt-5.4, gpt-5.6-sol"

# ----------------------------------------------------------------------#

# Azure OpenAI API Key and Endpoint for LowCost tier. If empty, Azure OpenAI LowCost tier will be disabled.
AL_LLM__AZURE_OPENAI__LOWCOST__API_KEY=""
AL_LLM__AZURE_OPENAI__LOWCOST__ENDPOINT=""
AL_LLM__AZURE_OPENAI__LOWCOST__MODELS="gpt-5.6-luna, gpt-5.4-mini"

# Azure OpenAI API Key and Endpoint for Premium tier. If empty, Azure OpenAI Premium tier will be disabled.
AL_LLM__AZURE_OPENAI__PREMIUM__API_KEY=""
AL_LLM__AZURE_OPENAI__PREMIUM__ENDPOINT=""
AL_LLM__AZURE_OPENAI__PREMIUM__MODELS="gpt-5.6-terra, gpt-5.4, gpt-5.6-sol"

# Azure OpenAI use Azure AD for authentication by default.
# If using Azure AD, set the following variables and leave the API keys above empty.
AZURE_TENANT_ID=""
AZURE_CLIENT_ID=""
AZURE_CLIENT_SECRET=""

# ----------------------------------------------------------------------#

# Claude API Key and Endpoint for LowCost tier. If empty, Claude LowCost tier will be disabled.
AL_LLM__CLAUDE__LOWCOST__API_KEY=""
AL_LLM__CLAUDE__LOWCOST__ENDPOINT=""
AL_LLM__CLAUDE__LOWCOST__MODELS="claude-haiku-4-5"

# Claude API Key and Endpoint for Premium tier. If empty, Claude Premium tier will be disabled.
AL_LLM__CLAUDE__PREMIUM__API_KEY=""
AL_LLM__CLAUDE__PREMIUM__ENDPOINT=""
AL_LLM__CLAUDE__PREMIUM__MODELS="claude-sonnet-5, claude-opus-5"

# ----------------------------------------------------------------------#

# OpenRouter API Key and Endpoint for LowCost tier. If empty, OpenRouter LowCost tier will be disabled.
AL_LLM__OPENROUTER__LOWCOST__API_KEY=""
AL_LLM__OPENROUTER__LOWCOST__ENDPOINT="https://openrouter.ai/api/v1/"
